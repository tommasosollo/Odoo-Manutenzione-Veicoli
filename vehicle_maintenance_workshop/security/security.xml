<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">


        <record id="module_category_workshop" model="ir.module.category">
            <field name="name">Workshop Manutenzione Veicoli</field>
            <field name="sequence">1</field>
        </record>

        <record id="privilege_workshop" model="res.groups.privilege">
            <field name="name">Ruoli Officina</field>
            <field name="category_id" ref="vehicle_maintenance_workshop.module_category_workshop"/>
        </record>

        <record id="privilege_workshop" model="res.groups.privilege">
            <field name="name">Accesso Officina</field>
            <field name="category_id" ref="module_category_workshop"/>
        </record>

        <record id="group_workshop_mechanic" model="res.groups">
            <field name="name">Meccanico</field>
            <field name="privilege_id" ref="vehicle_maintenance_workshop.privilege_workshop"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Accesso ai veicoli, agli interventi e ai prodotti</field>
        </record>

        <record id="group_workshop_chief" model="res.groups">
            <field name="name">Capo Officina</field>
            <field name="privilege_id" ref="vehicle_maintenance_workshop.privilege_workshop"/>
            <field name="implied_ids" eval="[(4, ref('vehicle_maintenance_workshop.group_workshop_mechanic'))]"/>
            <field name="comment">Accesso completo all'officina</field>
        </record>

        <record id="group_workshop_administration" model="res.groups">
            <field name="name">Amministrazione</field>
            <field name="privilege_id" ref="vehicle_maintenance_workshop.privilege_workshop"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Accesso alla fatturazione e alla contabilità</field>
        </record>

        <record id="mechanic_own_workorders_rule" model="ir.rule">
            <field name="name">Meccanico: vede i suoi interventi</field>
            <field name="model_id" ref="model_vehicle_workorder"></field>
            <field name="groups" eval="[Command.set([ref('vehicle_maintenance_workshop.group_workshop_mechanic')])]"></field>
            <field name="domain_force">[ '|', ('create_uid','=',user.id), ('id','=',0) ]</field>
        </record>

        <record id="chief_view_all_workorders_rule" model="ir.rule">
            <field name="name">Capo Officina: vede tutti i record</field>
            <field name="model_id" ref="model_vehicle_workorder"></field>
            <field name="groups" eval="[Command.set([ref('vehicle_maintenance_workshop.group_workshop_chief')])]"></field>
            <field name="domain_force">[]</field>
        </record>

    </data>

</odoo>