<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Azione Interventi -->
        <record id="action_intervention" model="ir.actions.act_window">
            <field name="name">Interventi</field>
            <field name="res_model">vehicle.workorder</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea intervento
                </p>
                <p>
                    Gestisci gli interventi di manutenzione dei veicoli.
                </p>
            </field>
        </record>

        <!-- Azione Fatture -->
        <record id="action_invoice" model="ir.actions.act_window">
            <field name="name">Fatture</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('move_type', '=', 'out_invoice')]</field>
            <field name="context">
                {'default_move_type': 'out_invoice'}
            </field>
        </record>

    </data>
</odoo>
