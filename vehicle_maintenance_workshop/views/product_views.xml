<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="custom_product_form_view" model="ir.ui.view">
        <field name="name">Custom Product Form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">

            <!-- Aggiunta delle informazioni personalizzate -->
            <xpath expr="//sheet/notebook" position="inside">

                <page string="Informazioni Officina">
                    <group>
                        <field name="standard_price"
                            widget="monetary"
                            options="{'currency_field': 'cost_currency_id'}"/>

                        <field name="cost_currency_id" invisible="1"/>

                        <field name="barcode"/>
                        <field name="quantita_rimasta"/>

                        <field name="quantita_totale"
                            groups="vehicle_maintenance_workshop.group_workshop_chief"/>
                    </group>
                </page>

            </xpath>

        </field>
    </record>


    <record id="custom_product_product_list_view" model="ir.ui.view">
        <field name="name">Custom Product Variant list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Product Variant">
                <field name="name"/>
                <field name="barcode"/>
                <field name="standard_price" widget="monetary"/>
                <field name="quantita_rimasta"/>
            </list>
        </field>
    </record>

    <record id="action_product_product" model="ir.actions.act_window">
        <field name="name">Prodotti</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="custom_product_product_list_view"/>
        <field name="help" type="html">
            <p>
                Visualizza i prodotti disponibili.
            </p>
        </field>
    </record>

</odoo>
